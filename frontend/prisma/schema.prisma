generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  interviews InterviewSession[]
}

model InterviewSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  company      String
  jobRole      String
  lpaCategory  String
  status       String   @default("IN_PROGRESS") // IN_PROGRESS, PASSED, FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rounds       InterviewRound[]
}

model InterviewRound {
  id             String   @id @default(cuid())
  sessionId      String
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber    Int
  roundName      String
  roundType      String   // e.g. APTITUDE, TECHNICAL, HR
  description    String?
  status         String   @default("LOCKED") // LOCKED, ACTIVE, PASSED, FAILED
  score          Int?
  feedback       String?
  studyPlan      String?
  lookAwayCount  Int      @default(0)
  fillerWords    Int      @default(0)
}
